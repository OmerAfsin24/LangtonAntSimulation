{
    "version": 8,
    "configurePresets": [
        {
            "name": "LangtonsAntSimulationPreset",
            "displayName": "Langton's Ant Simulation",
            "description": "Configures the application with Ninja",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            }
        }
    ]
}